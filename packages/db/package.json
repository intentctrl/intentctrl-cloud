{
  "name": "@intentctrl-cloud/db",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Shared Drizzle ORM schema and client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@intentctrl-cloud/eslint-config": "workspace:*",
    "@intentctrl-cloud/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "catalog:",
    "dotenv": "^16.5.0",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
