{
  "name": "@intentctrl-cloud/types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types for IntentCtrl",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@intentctrl-cloud/eslint-config": "workspace:*",
    "@intentctrl-cloud/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
